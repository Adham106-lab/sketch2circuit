{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@s2c/circuit-json": [
        "./packages/circuit-json/src/index.ts"
      ],
      "@s2c/units": [
        "./packages/units/src/index.ts"
      ],
      "@s2c/parts": [
        "./packages/parts/src/index.ts"
      ],
      "@s2c/core": [
        "./packages/core/src/index.ts"
      ],
      "@s2c/core/jsx-runtime": [
        "./packages/core/src/jsx-runtime.ts"
      ],
      "@s2c/render-schematic": [
        "./packages/render-schematic/src/index.ts"
      ],
      "@s2c/rules": [
        "./packages/rules/src/index.ts"
      ],
      "@s2c/arduino": [
        "./packages/arduino/src/index.ts"
      ],
      "@s2c/export": [
        "./packages/export/src/index.ts"
      ],
      "@s2c/cli": [
        "./packages/cli/src/index.ts"
      ],
      "@s2c/pcb-json": [
        "./packages/pcb-json/src/index.ts"
      ],
      "@s2c/footprints": [
        "./packages/footprints/src/index.ts"
      ],
      "@s2c/pcb-layout": [
        "./packages/pcb-layout/src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
