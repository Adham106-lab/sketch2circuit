  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node -e \"import('node:fs').then(fs => fs.cpSync('dist', 'build', { recursive: true }))\"",
