{
  "name": "sketch2circuit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "check:deps": "node scripts/check-dependency-majors.mjs",
    "typecheck": "tsc --noEmit",
